<!DOCTYPE html>
<html lang="en" data-theme="<%= locals.theme || 'light' %>">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="<%= locals.description || 'JobPortal - Connect with top employers and find your perfect career opportunity' %>" />
    <meta name="theme-color" content="#6366f1" />
    <title><%= locals.title ? locals.title + ' - JobPortal' : 'JobPortal - Find Your Dream Job' %></title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/css/styles.css" />
    
    <script>
        window.appConfig = {
            user: <%- JSON.stringify(locals.user || null) %>,
            isAuthenticated: <%= Boolean(locals.user) %>,
            userRole: '<%= locals.user ? locals.user.role : "" %>'
        };
    </script>
</head>
<body>
    <a href="#mainContent" class="skip-link">Skip to main content</a>
    
    <div id="app" class="page-wrapper">
        <% if (locals.user) { %>
            <aside class="sidebar <%= locals.sidebarCollapsed ? 'collapsed' : '' %>" id="sidebar" role="navigation" aria-label="Main navigation">
                <div class="sidebar-header">
                    <a href="/" class="sidebar-brand" aria-label="JobPortal Home">
                        <div class="sidebar-logo">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                        <span class="sidebar-brand-text">JobPortal</span>
                    </a>
                    <button class="sidebar-collapse-btn" data-sidebar-toggle aria-label="Collapse sidebar" aria-expanded="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                </div>
                
                <nav class="sidebar-nav" aria-label="Sidebar navigation">
                    <%- include('../layout/sidebar') %>
                </nav>
                
                <div class="sidebar-footer">
                    <div class="sidebar-user">
                        <div class="sidebar-user-avatar">
                            <%= locals.user.name ? locals.user.name.charAt(0).toUpperCase() : 'U' %>
                        </div>
                        <div class="sidebar-user-info">
                            <div class="sidebar-user-name"><%= locals.user.name %></div>
                            <div class="sidebar-user-role"><%= locals.user.role %></div>
                        </div>
                    </div>
                </div>
            </aside>
            
            <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>
            
            <header class="header <%= locals.sidebarCollapsed ? 'sidebar-collapsed' : '' %>" id="header" role="banner">
                <div class="header-left">
                    <button class="sidebar-toggle" data-mobile-menu-toggle aria-label="Toggle menu" aria-expanded="false" aria-controls="sidebar">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                    <% if (locals.pageTitle) { %>
                        <h1 class="page-title-header"><%= locals.pageTitle %></h1>
                    <% } %>
                </div>
                
                <div class="header-right">
                    <div class="dropdown" id="notificationDropdown">
                        <button class="header-action" data-dropdown-toggle aria-label="Notifications" aria-expanded="false" aria-haspopup="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                            <span class="header-action-badge" id="notificationBadge" style="display: <%= locals.unreadNotificationsCount ? 'flex' : 'none' %>;">
                                <%= locals.unreadNotificationsCount || 0 %>
                            </span>
                        </button>
                        <div class="dropdown-menu notification-dropdown" role="menu" aria-label="Notifications">
                            <div class="notification-header">
                                <h3 class="notification-title">Notifications</h3>
                                <button class="notification-mark-all" id="markAllReadBtn" data-mark-all-read>Mark all read</button>
                            </div>
                            <div class="notification-list" id="notificationList">
                                <% if (locals.notificationsList && locals.notificationsList.length > 0) { %>
                                    <% locals.notificationsList.forEach(n => { %>
                                        <div class="notification-item <%= n.read ? '' : 'unread' %>" style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-primary);">
                                            <div style="font-weight: 600; font-size: 0.875rem; color: var(--text-primary);"><%= n.title %></div>
                                            <div style="font-size: 0.8125rem; color: var(--text-secondary); margin-top: 0.25rem;"><%= n.message %></div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="notification-empty">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                        </svg>
                                        <p>No notifications yet</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    
                    <button class="header-action theme-toggle" data-theme-toggle aria-label="Toggle theme" title="Toggle theme">
                        <svg data-theme-icon="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                            <circle cx="12" cy="12" r="5"></circle>
                            <line x1="12" y1="1" x2="12" y2="3"></line>
                            <line x1="12" y1="21" x2="12" y2="23"></line>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                            <line x1="1" y1="12" x2="3" y2="12"></line>
                            <line x1="21" y1="12" x2="23" y2="12"></line>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                        </svg>
                        <svg data-theme-icon="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                        </svg>
                    </button>
                    
                    <div class="dropdown user-menu" id="userMenu">
                        <button class="user-menu-trigger" data-dropdown-toggle aria-label="User menu" aria-expanded="false" aria-haspopup="true">
                            <div class="user-avatar">
                                <%= locals.user.name ? locals.user.name.charAt(0).toUpperCase() : 'U' %>
                            </div>
                            <div class="user-info">
                                <span class="user-name"><%= locals.user.name %></span>
                                <span class="user-role"><%= locals.user.role %></span>
                            </div>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <div class="dropdown-menu user-menu-dropdown" role="menu" aria-label="User menu">
                            <div class="user-menu-header">
                                <div class="user-menu-email"><%= locals.user.email %></div>
                            </div>
                            <a href="/account/profile" class="user-menu-item" role="menuitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                Profile
                            </a>
                            <div class="user-menu-divider"></div>
                            <a href="/auth/logout" class="user-menu-item danger w-100" role="menuitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                Sign Out
                            </a>
                        </div>
                    </div>
                </div>
            </header>
        <% } else { %>
            <header class="public-nav" role="banner">
                <div class="container d-flex justify-between items-center" style="max-width: 1200px; margin: 0 auto; padding: 0.875rem 1.5rem;">
                    <a href="/" class="sidebar-brand" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none;">
                        <div class="sidebar-logo" style="width: 38px; height: 38px; background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; color: white; box-shadow: 0 2px 8px rgba(99, 102, 241, 0.35);">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                        <span style="font-size: 1.25rem; font-weight: 700; color: var(--header-text); letter-spacing: -0.02em;">JobPortal</span>
                    </a>
                    <div class="d-flex items-center gap-3">
                        <a href="/jobs" class="btn btn-ghost">Browse Jobs</a>
                        <button class="header-action theme-toggle" data-theme-toggle aria-label="Toggle theme" title="Toggle theme">
                            <svg data-theme-icon="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
                                <circle cx="12" cy="12" r="5"></circle>
                                <line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line>
                                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                            </svg>
                            <svg data-theme-icon="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                            </svg>
                        </button>
                        <a href="/auth/login" class="btn btn-outline-secondary">Sign In</a>
                        <a href="/auth/register" class="btn btn-primary">Sign Up</a>
                    </div>
                </div>
            </header>
        <% } %>
        
        <main class="main-content <%= locals.sidebarCollapsed ? 'sidebar-collapsed' : '' %> <%= !locals.user ? 'no-sidebar' : '' %>" id="mainContent" role="main">
            <div class="content-area <%= !locals.user ? 'auth-layout' : '' %>" id="contentArea">
