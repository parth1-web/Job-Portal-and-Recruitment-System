@{
    var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "User";
    var displayRole = User.FindFirst("role")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
    var displayEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "user@example.com";
    var displayInitial = string.IsNullOrEmpty(displayName) ? "U" : displayName.Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="en" data-theme="@(ViewData["Theme"]?.ToString() ?? "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="theme-color" content="#6366f1" />
    <title>@ViewData["Title"] - JobPortal</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    
    @RenderSection("Styles", required: false)
    
    @inject Microsoft.Extensions.Configuration.IConfiguration Configuration
    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

    <script>
        window.appConfig = {
            apiBaseUrl: '@Configuration["ApiSettings:BaseUrl"]',
            user: @Html.Raw(Json.Serialize(new { name = displayName, role = displayRole, email = displayEmail })),
            isAuthenticated: @((User.Identity?.IsAuthenticated ?? false).ToString().ToLower()),
            userRole: '@(User.FindFirst("role")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "")',
            csrfToken: '@Antiforgery.GetAndStoreTokens(Context).RequestToken'
        };
    </script>
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <div id="app" class="page-wrapper">
        @{
            var sidebarCollapsed = User.Identity?.IsAuthenticated == true && ViewData["SidebarCollapsed"] as bool? == true;
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside class="sidebar @(sidebarCollapsed ? "collapsed" : "")" id="sidebar" role="navigation" aria-label="Main navigation">
                <div class="sidebar-header">
                    <a href="@Url.Action("Index", "Home")" class="sidebar-brand" aria-label="JobPortal Home">
                        <div class="sidebar-logo">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                        <span class="sidebar-brand-text">JobPortal</span>
                    </a>
                    <button class="sidebar-collapse-btn" data-sidebar-toggle aria-label="Collapse sidebar" aria-expanded="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                </div>
                
                <nav class="sidebar-nav" aria-label="Sidebar navigation">
                    @await Html.PartialAsync("_SidebarNav")
                </nav>
                
                <div class="sidebar-footer">
                    <div class="sidebar-user">
                        <div class="sidebar-user-avatar">
                            @displayInitial
                        </div>
                        <div class="sidebar-user-info">
                            <div class="sidebar-user-name">@displayName</div>
                            <div class="sidebar-user-role">@displayRole</div>
                        </div>
                    </div>
                </div>
            </aside>
            
            <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>
            
            <header class="header @(sidebarCollapsed ? "sidebar-collapsed" : "")" id="header" role="banner">
                <div class="header-left">
                    <button class="sidebar-toggle" data-mobile-menu-toggle aria-label="Toggle menu" aria-expanded="false" aria-controls="sidebar">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                    @if (!string.IsNullOrEmpty(ViewData["PageTitle"]?.ToString()))
                    {
                        <h1 class="page-title-header">@ViewData["PageTitle"]</h1>
                    }
                </div>
                
                <div class="header-right">
                    <div class="dropdown" id="notificationDropdown">
                        <button class="header-action" data-dropdown-toggle aria-label="Notifications" aria-expanded="false" aria-haspopup="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                            <span class="header-action-badge" id="notificationBadge" style="display: none;">0</span>
                        </button>
                        <div class="dropdown-menu notification-dropdown" role="menu" aria-label="Notifications">
                            <div class="notification-header">
                                <h3 class="notification-title">Notifications</h3>
                                <button class="notification-mark-all" data-mark-all-read>Mark all read</button>
                            </div>
                            <div class="notification-list" id="notificationList">
                                <div class="notification-empty">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                    </svg>
                                    <p>No notifications yet</p>
                                </div>
                            </div>
                            <div class="notification-footer">
                                <a href="@Url.Action("Index", "Notifications")" class="notification-view-all">View all notifications</a>
                            </div>
                        </div>
                    </div>
                    
                    <button class="header-action theme-toggle" data-theme-toggle aria-label="Toggle theme" title="Toggle theme">
                        <svg data-theme-icon="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                            <circle cx="12" cy="12" r="5"></circle>
                            <line x1="12" y1="1" x2="12" y2="3"></line>
                            <line x1="12" y1="21" x2="12" y2="23"></line>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                            <line x1="1" y1="12" x2="3" y2="12"></line>
                            <line x1="21" y1="12" x2="23" y2="12"></line>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                        </svg>
                        <svg data-theme-icon="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                        </svg>
                    </button>
                    
                    <div class="dropdown user-menu" id="userMenu">
                        <button class="user-menu-trigger" data-dropdown-toggle aria-label="User menu" aria-expanded="false" aria-haspopup="true">
                            <div class="user-avatar">
                                @displayInitial
                            </div>
                            <div class="user-info">
                                <span class="user-name">@displayName</span>
                                <span class="user-role">@displayRole</span>
                            </div>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <div class="dropdown-menu user-menu-dropdown" role="menu" aria-label="User menu">
                            <div class="user-menu-header">
                                <div class="user-menu-email">@displayEmail</div>
                            </div>
                            <a href="@Url.Action("Profile", "Account")" class="user-menu-item" role="menuitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                Profile
                            </a>
                            <a href="@Url.Action("Settings", "Account")" class="user-menu-item" role="menuitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                                Settings
                            </a>
                            <div class="user-menu-divider"></div>
                            <form method="post" asp-controller="Auth" asp-action="Logout" class="d-flex w-100">
                                <button type="submit" class="user-menu-item danger w-100" role="menuitem">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                    Sign Out
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>
        }
        
        <main class="main-content @(sidebarCollapsed ? "sidebar-collapsed" : "") @(User.Identity?.IsAuthenticated != true ? "no-sidebar" : "")" id="mainContent" role="main">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="content-area" id="contentArea">
                    @RenderBody()
                </div>
            }
            else
            {
                <div class="content-area auth-layout">
                    @RenderBody()
                </div>
            }
        </main>
        
        @if (User.Identity?.IsAuthenticated == true)
        {
            <footer class="footer" role="contentinfo">
                <div class="container">
                    <p class="footer-text">&copy; @DateTime.Now.Year JobPortal. All rights reserved.</p>
                </div>
            </footer>
        }
    </div>
    
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    
    @RenderSection("Scripts", required: false)
    
    @await RenderSectionAsync("InlineScripts", required: false)
</body>
</html>