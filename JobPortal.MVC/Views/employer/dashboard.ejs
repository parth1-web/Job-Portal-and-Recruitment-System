<%- include('../layout/header') %>

<div class="dashboard-page animate-fade-in" style="max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem;">
    <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 class="page-title" style="font-size: 1.875rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.25rem 0;">
                Employer Dashboard
            </h1>
            <p class="page-subtitle" style="color: var(--text-tertiary); margin: 0;">Manage your open roles and candidate applications for <%= locals.company ? locals.company.name : 'TechCorp Solutions' %></p>
        </div>
        <div class="d-flex gap-3">
            <a href="/employerjobs/create" class="btn btn-primary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Post a Job
            </a>
            <a href="/employerdashboard/company" class="btn btn-outline-secondary">
                Company Profile
            </a>
        </div>
    </div>

    <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
        <div class="stat-card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-size: 0.875rem; font-weight: 500; color: var(--text-tertiary);">Total Jobs Posted</span>
                <div style="width: 36px; height: 36px; border-radius: var(--radius-md); background: rgba(99, 102, 241, 0.1); color: var(--color-primary); display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                </div>
            </div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--text-primary); line-height: 1;"><%= locals.stats.totalJobs %></div>
            <div style="font-size: 0.8125rem; color: var(--text-tertiary); margin-top: 0.5rem;"><a href="/employerdashboard/jobs" style="color: var(--color-primary); text-decoration: none;">View all &rarr;</a></div>
        </div>

        <div class="stat-card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-size: 0.875rem; font-weight: 500; color: var(--text-tertiary);">Active Roles</span>
                <div style="width: 36px; height: 36px; border-radius: var(--radius-md); background: rgba(16, 185, 129, 0.1); color: var(--color-success); display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
            </div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--text-primary); line-height: 1;"><%= locals.stats.activeJobs %></div>
            <div style="font-size: 0.8125rem; color: var(--text-tertiary); margin-top: 0.5rem;">Accepting applicants</div>
        </div>

        <div class="stat-card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-size: 0.875rem; font-weight: 500; color: var(--text-tertiary);">Total Applicants</span>
                <div style="width: 36px; height: 36px; border-radius: var(--radius-md); background: rgba(245, 158, 11, 0.1); color: var(--color-warning); display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                </div>
            </div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--text-primary); line-height: 1;"><%= locals.stats.totalApplications %></div>
            <div style="font-size: 0.8125rem; color: var(--text-tertiary); margin-top: 0.5rem;"><a href="/employerdashboard/applications" style="color: var(--color-primary); text-decoration: none;">Review all &rarr;</a></div>
        </div>

        <div class="stat-card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-size: 0.875rem; font-weight: 500; color: var(--text-tertiary);">Pending Reviews</span>
                <div style="width: 36px; height: 36px; border-radius: var(--radius-md); background: rgba(6, 182, 212, 0.1); color: var(--color-info); display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </div>
            </div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--text-primary); line-height: 1;"><%= locals.stats.pendingApplications %></div>
            <div style="font-size: 0.8125rem; color: var(--text-tertiary); margin-top: 0.5rem;">Require decision</div>
        </div>
    </div>

    <div class="dashboard-grid-split" style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; align-items: start;">
        <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin: 0;">My Active Job Postings</h2>
                <a href="/employerjobs/create" class="btn btn-sm btn-primary">+ Post New Job</a>
            </div>

            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <% locals.employerJobs.forEach(job => { %>
                    <div class="card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-lg); padding: 1.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                        <div>
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600;">
                                    <a href="/jobs/<%= job.id %>" style="color: var(--text-primary); text-decoration: none;"><%= job.title %></a>
                                </h3>
                                <span class="badge <%= job.status === 'Active' ? 'badge-success' : 'badge-soft' %>"><%= job.status %></span>
                            </div>
                            <p style="margin: 0.25rem 0 0; color: var(--text-tertiary); font-size: 0.875rem;">
                                <%= job.location %> &middot; <%= job.employmentType %> &middot; <%= job.applicationsCount %> applicants
                            </p>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <a href="/employerdashboard/applications?jobId=<%= job.id %>" class="btn btn-sm btn-outline-primary">View Applicants</a>
                            <a href="/jobs/<%= job.id %>" class="btn btn-sm btn-ghost">Preview</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <div>
            <div class="card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.5rem; margin-bottom: 1.5rem;">
                <h3 style="font-size: 1.125rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1rem;">Recent Applicants</h3>
                <% if (locals.recentApplications && locals.recentApplications.length > 0) { %>
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        <% locals.recentApplications.forEach(app => { %>
                            <div style="padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-primary);">
                                <h4 style="margin: 0 0 0.15rem 0; font-size: 0.95rem; font-weight: 600; color: var(--text-primary);"><%= app.candidateName %></h4>
                                <p style="margin: 0 0 0.35rem 0; font-size: 0.8125rem; color: var(--text-tertiary);">Applied for <%= app.jobTitle %></p>
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span class="badge badge-soft" style="font-size: 0.75rem;"><%= app.status %></span>
                                    <a href="/employerdashboard/applications" style="font-size: 0.8125rem; color: var(--color-primary); text-decoration: none;">Review &rarr;</a>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p style="color: var(--text-tertiary); font-size: 0.875rem; margin: 0;">No applications received yet.</p>
                <% } %>
            </div>

            <div class="card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.5rem;">
                <h3 style="font-size: 1.125rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">Hiring Resources</h3>
                <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1rem;">
                    Need to boost candidate reach? Share your company profile and verified jobs with candidates.
                </p>
                <a href="/employerdashboard/company" class="btn btn-outline-secondary w-full btn-sm">Edit Company Info</a>
            </div>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
