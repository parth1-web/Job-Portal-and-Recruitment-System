@model JobPortal.MVC.Models.CreateJobRequest
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Post a Job";
    ViewData["PageTitle"] = "Post a New Job";
    ViewData["UserRole"] = "Employer";
    var skills = ViewData["Skills"] as List<JobPortal.MVC.Models.SkillDto> ?? new List<JobPortal.MVC.Models.SkillDto>();
    var categories = ViewData["Categories"] as List<string> ?? new List<string>();
}

<div class="job-form-page animate-fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <span class="page-title-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </span>
                Post a New Job
            </h1>
            <p class="page-subtitle">Fill in the details below to create a new job posting</p>
        </div>
    </div>

    <form method="post" asp-action="Create" class="job-form">
        <input type="hidden" name="CompanyId" value="@ViewData["CompanyId"]" />

        <div class="form-section">
            <h3 class="form-section-title">Basic Information</h3>
            
            <div class="form-group">
                <label for="Title" class="form-label required">Job Title</label>
                <input type="text" id="Title" name="Title" class="form-input" placeholder="e.g., Senior Software Engineer" value="@Model.Title" required maxlength="200" />
                <span class="form-error" data-valmsg-for="Title"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="Location" class="form-label required">Location</label>
                    <input type="text" id="Location" name="Location" class="form-input" placeholder="City, State or Remote" value="@Model.Location" required />
                </div>
                <div class="form-group">
                    <label for="WorkMode" class="form-label required">Work Mode</label>
                    <select id="WorkMode" name="WorkMode" class="form-select" required asp-items="@(new List<SelectListItem> {
                        new SelectListItem { Value = "OnSite", Text = "On-Site", Selected = Model.WorkMode == "OnSite" },
                        new SelectListItem { Value = "Remote", Text = "Remote", Selected = Model.WorkMode == "Remote" },
                        new SelectListItem { Value = "Hybrid", Text = "Hybrid", Selected = Model.WorkMode == "Hybrid" }
                    })"></select>
                </div>
            </div>

            <div class="form-group">
                <label for="EmploymentType" class="form-label required">Employment Type</label>
                <select id="EmploymentType" name="EmploymentType" class="form-select" required asp-items="@(new List<SelectListItem> {
                    new SelectListItem { Value = "FullTime", Text = "Full Time", Selected = Model.EmploymentType == "FullTime" },
                    new SelectListItem { Value = "PartTime", Text = "Part Time", Selected = Model.EmploymentType == "PartTime" },
                    new SelectListItem { Value = "Contract", Text = "Contract", Selected = Model.EmploymentType == "Contract" },
                    new SelectListItem { Value = "Internship", Text = "Internship", Selected = Model.EmploymentType == "Internship" },
                    new SelectListItem { Value = "Temporary", Text = "Temporary", Selected = Model.EmploymentType == "Temporary" }
                })"></select>
            </div>
        </div>

        <div class="form-section">
            <h3 class="form-section-title">Job Details</h3>
            
            <div class="form-group">
                <label for="Description" class="form-label required">Job Description</label>
                <textarea id="Description" name="Description" class="form-textarea" rows="8" placeholder="Describe the role, responsibilities, and what the candidate will be working on..." required minlength="50" maxlength="5000">@Model.Description</textarea>
                <span class="form-help">Minimum 50 characters. Be detailed about the role and expectations.</span>
                <span class="form-error" data-valmsg-for="Description"></span>
            </div>

            <div class="form-group">
                <label for="Requirements" class="form-label required">Requirements</label>
                <textarea id="Requirements" name="Requirements" class="form-textarea" rows="6" placeholder="List the required skills, experience, education, and qualifications..." required minlength="20" maxlength="3000">@Model.Requirements</textarea>
                <span class="form-help">Minimum 20 characters. Include must-have skills and experience.</span>
                <span class="form-error" data-valmsg-for="Requirements"></span>
            </div>

            <div class="form-group">
                <label for="Benefits" class="form-label">Benefits & Perks</label>
                <textarea id="Benefits" name="Benefits" class="form-textarea" rows="4" placeholder="Health insurance, 401k, flexible hours, remote work options, etc." maxlength="2000">@Model.Benefits</textarea>
                <span class="form-help">Optional. Highlight what makes your company great to work for.</span>
                <span class="form-error" data-valmsg-for="Benefits"></span>
            </div>

            <div class="form-group">
                <label for="Responsibilities" class="form-label">Key Responsibilities</label>
                <textarea id="Responsibilities" name="Responsibilities" class="form-textarea" rows="5" placeholder="List key responsibilities, one per line..." maxlength="1000">@Model.Responsibilities</textarea>
                <span class="form-help">Optional. One responsibility per line.</span>
                <span class="form-error" data-valmsg-for="Responsibilities"></span>
            </div>

            <div class="form-group">
                <label for="PreferredQualifications" class="form-label">Preferred Qualifications</label>
                <textarea id="PreferredQualifications" name="PreferredQualifications" class="form-textarea" rows="4" placeholder="Nice-to-have skills, certifications, or experience..." maxlength="1000">@Model.PreferredQualifications</textarea>
                <span class="form-help">Optional. These are bonuses, not requirements.</span>
                <span class="form-error" data-valmsg-for="PreferredQualifications"></span>
            </div>
        </div>

        <div class="form-section">
            <h3 class="form-section-title">Compensation</h3>
            
            <div class="form-row">
                <div class="form-group">
                    <label for="MinSalary" class="form-label">Minimum Salary (Annual)</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" id="MinSalary" name="MinSalary" class="form-input" placeholder="80000" value="@Model.MinSalary" min="0" step="1000" />
                    </div>
                </div>
                <div class="form-group">
                    <label for="MaxSalary" class="form-label">Maximum Salary (Annual)</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" id="MaxSalary" name="MaxSalary" class="form-input" placeholder="120000" value="@Model.MaxSalary" min="0" step="1000" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="Currency" class="form-label">Currency</label>
                <select id="Currency" name="Currency" class="form-select" asp-items="@(new List<SelectListItem> {
                    new SelectListItem { Value = "USD", Text = "USD ($)", Selected = Model.Currency == "USD" },
                    new SelectListItem { Value = "EUR", Text = "EUR (€)", Selected = Model.Currency == "EUR" },
                    new SelectListItem { Value = "GBP", Text = "GBP (£)", Selected = Model.Currency == "GBP" },
                    new SelectListItem { Value = "CAD", Text = "CAD ($)", Selected = Model.Currency == "CAD" },
                    new SelectListItem { Value = "AUD", Text = "AUD ($)", Selected = Model.Currency == "AUD" }
                })"></select>
            </div>
        </div>

        <div class="form-section">
            <h3 class="form-section-title">Skills</h3>
            
            <div class="form-group">
                <label class="form-label">Required Skills</label>
                <div class="skills-selector" id="skillsSelector">
                    @foreach (var skill in skills.Take(20))
                    {
                        <label class="skill-tag @(Model.SkillIds.Contains(skill.Id) ? "selected" : "")" data-skill-id="@skill.Id">
                            <input type="checkbox" name="SkillIds" value="@skill.Id" @(Model.SkillIds.Contains(skill.Id) ? "checked" : "") style="display: none;" />
                            <span>@skill.Name</span>
                            @if (!string.IsNullOrEmpty(skill.Category))
                            {
                                <span class="skill-category">@skill.Category</span>
                            }
                        </label>
                    }
                </div>
                <span class="form-help">Select up to 10 required skills. Type to search for more skills.</span>
            </div>
        </div>

        <div class="form-section">
            <h3 class="form-section-title">Additional Details</h3>
            
            <div class="form-row">
                <div class="form-group">
                    <label for="ExpiryDate" class="form-label">Application Deadline</label>
                    <input type="date" id="ExpiryDate" name="ExpiryDate" class="form-input" value="@Model.ExpiryDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-group">
                    <label for="Status" class="form-label">Status</label>
                    <select id="Status" name="Status" class="form-select" asp-items="@(new List<SelectListItem> {
                        new SelectListItem { Value = "Draft", Text = "Draft", Selected = Model.Status == "Draft" },
                        new SelectListItem { Value = "Published", Text = "Published", Selected = Model.Status == "Published" }
                    })"></select>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a href="@Url.Action("Jobs", "EmployerDashboard")" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" name="action" value="draft" class="btn btn-secondary">Save as Draft</button>
            <button type="submit" name="action" value="publish" class="btn btn-primary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Post Job
            </button>
        </div>
    </form>
</div>

<style>
.job-form-page {
    padding: 0;
}

.job-form {
    max-width: 900px;
}

.form-section {
    background: var(--bg-card);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
}

.form-section-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-primary);
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-primary);
    margin-top: 1rem;
}

.skills-selector {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-height: 300px;
    overflow-y: auto;
    padding: 0.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
}

.skill-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    background: var(--bg-input);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.skill-tag:hover {
    border-color: var(--color-primary);
}

.skill-tag.selected {
    background: rgba(var(--color-primary-rgb), 0.15);
    border-color: var(--color-primary);
    color: var(--color-primary);
}

.skill-tag.selected .skill-category {
    color: var(--color-primary);
}

.skill-category {
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.025em;
}

@@media (max-width: 640px) {
    .form-row {
        grid-template-columns: 1fr;
    }
    
    .form-actions {
        flex-direction: column;
    }
    
    .form-actions .btn {
        width: 100%;
    }
}
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const skillTags = document.querySelectorAll('.skill-tag');
            const maxSkills = 10;
            
            skillTags.forEach(tag => {
                tag.addEventListener('click', function() {
                    const checkbox = this.querySelector('input[type="checkbox"]');
                    const currentlySelected = document.querySelectorAll('.skill-tag.selected').length;
                    
                    if (this.classList.contains('selected')) {
                        this.classList.remove('selected');
                        checkbox.checked = false;
                    } else {
                        if (currentlySelected >= maxSkills) {
                            showToast('You can select up to ' + maxSkills + ' skills', 'warning');
                            return;
                        }
                        this.classList.add('selected');
                        checkbox.checked = true;
                    }
                });
            });
        });
    </script>
}