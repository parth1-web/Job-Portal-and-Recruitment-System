@model JobPortal.MVC.Models.UpdateJobRequest
@{
    ViewData["Title"] = "Edit Job";
    var skills = ViewData["Skills"] as List<JobPortal.MVC.Models.SkillDto> ?? new List<JobPortal.MVC.Models.SkillDto>();
}

<div class="animate-fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">Edit Job</h1>
            <p class="page-subtitle">Update the details of your job posting</p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="card mb-4"><div class="card-body" style="border-left: 4px solid var(--color-danger);">@TempData["ErrorMessage"]</div></div>
    }

    <div class="card" style="max-width: 860px;">
        <div class="card-body">
            <form method="post" asp-action="Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CategoryId" value="@Model.CategoryId" />
                <div class="form-group">
                    <label for="Title" class="form-label required">Job Title</label>
                    <input type="text" id="Title" name="Title" class="form-input" value="@Model.Title" required maxlength="200" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="Location" class="form-label required">Location</label>
                        <input type="text" id="Location" name="Location" class="form-input" value="@Model.Location" required />
                    </div>
                    <div class="form-group">
                        <label for="WorkMode" class="form-label required">Work Mode</label>
                        <select id="WorkMode" name="WorkMode" class="form-select" required>
                            @foreach (var m in new[] { "OnSite", "Remote", "Hybrid" })
                            {
                                if (Model.WorkMode == m)
                                {
                                    <option value="@m" selected>@m</option>
                                }
                                else
                                {
                                    <option value="@m">@m</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="EmploymentType" class="form-label required">Employment Type</label>
                        <select id="EmploymentType" name="EmploymentType" class="form-select" required>
                            @foreach (var t in new[] { "FullTime", "PartTime", "Contract", "Internship", "Temporary" })
                            {
                                if (Model.EmploymentType == t)
                                {
                                    <option value="@t" selected>@t</option>
                                }
                                else
                                {
                                    <option value="@t">@t</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="Status" class="form-label required">Status</label>
                        <select id="Status" name="Status" class="form-select" required>
                            @foreach (var s in new[] { "Draft", "Published", "Closed" })
                            {
                                if (Model.Status == s)
                                {
                                    <option value="@s" selected>@s</option>
                                }
                                else
                                {
                                    <option value="@s">@s</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label for="Description" class="form-label required">Description</label>
                    <textarea id="Description" name="Description" class="form-textarea" rows="6" required>@Model.Description</textarea>
                </div>
                <div class="form-group">
                    <label for="Requirements" class="form-label required">Requirements</label>
                    <textarea id="Requirements" name="Requirements" class="form-textarea" rows="4" required>@Model.Requirements</textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="MinSalary" class="form-label">Min Salary</label>
                        <input type="number" id="MinSalary" name="MinSalary" class="form-input" value="@Model.MinSalary" min="0" step="1000" />
                    </div>
                    <div class="form-group">
                        <label for="MaxSalary" class="form-label">Max Salary</label>
                        <input type="number" id="MaxSalary" name="MaxSalary" class="form-input" value="@Model.MaxSalary" min="0" step="1000" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Required Skills</label>
                    <div class="skills-filter" style="display:flex;flex-wrap:wrap;gap:.5rem;">
                        @foreach (var skill in skills.Take(20))
                        {
                            <label class="skill-checkbox">
                                <input type="checkbox" name="SkillIds" value="@skill.Id" @(Model.SkillIds.Contains(skill.Id) ? "checked" : "") />
                                <span>@skill.Name</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a href="javascript:history.back()" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
