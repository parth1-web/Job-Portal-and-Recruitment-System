@model JobPortal.MVC.Models.JobDetailDto
@{
    ViewData["Title"] = Model.Title;
}

<div class="animate-fade-in">
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <span class="breadcrumb-item"><a class="breadcrumb-link" href="@Url.Action("Jobs", "EmployerDashboard")">My Jobs</a></span>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">@Model.Title</span>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="card mb-4"><div class="card-body" style="border-left: 4px solid var(--color-success);">@TempData["SuccessMessage"]</div></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="card mb-4"><div class="card-body" style="border-left: 4px solid var(--color-danger);">@TempData["ErrorMessage"]</div></div>
    }

    <div class="page-header">
        <div>
            <h1 class="page-title">@Model.Title</h1>
            <p class="page-subtitle">@Model.Location &middot; @Model.WorkMode &middot; @Model.EmploymentType</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <span class="badge badge-soft">@Model.Status</span>
            <a href="@Url.Action("Applications", "EmployerDashboard", new { jobId = Model.Id })" class="btn btn-primary">View Applications (@Model.ApplicationsCount)</a>
            <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-outline-secondary">Edit</a>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h3 class="card-title">Description</h3></div>
        <div class="card-body"><p style="white-space: pre-line;">@Model.Description</p></div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Requirements))
    {
        <div class="card mt-4">
            <div class="card-header"><h3 class="card-title">Requirements</h3></div>
            <div class="card-body"><p style="white-space: pre-line;">@Model.Requirements</p></div>
        </div>
    }

    <div class="card mt-4">
        <div class="card-header"><h3 class="card-title">Danger Zone</h3></div>
        <div class="card-body d-flex justify-between items-center flex-wrap gap-3">
            <div>
                <div class="font-medium">Close this job</div>
                <div class="text-sm text-tertiary">Closed jobs stop accepting applications.</div>
            </div>
            <form method="post" asp-action="Delete" asp-route-id="@Model.Id" data-confirm="Close this job posting?">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">Close Job</button>
            </form>
        </div>
    </div>
</div>
