@model JobPortal.MVC.Controllers.CandidateDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["UserRole"] = "Candidate";
}

<div class="dashboard-page animate-fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <span class="page-title-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                    </svg>
                </span>
                Dashboard
            </h1>
            <p class="page-subtitle">Welcome back, @(User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Candidate")! Here's your job search overview.</p>
        </div>
        <div class="d-flex gap-3">
            <a href="@Url.Action("Index", "Jobs")" class="btn btn-primary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                Browse Jobs
            </a>
            <a href="@Url.Action("Create", "CandidateProfile")" class="btn btn-outline-secondary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="2.5"></circle><line x1="23" y1="7" x2="17" y2="7"></line></svg>
                Update Profile
            </a>
        </div>
    </div>

    @if (Model.Stats != null)
    {
        <div class="stats-grid animate-slide-up stagger-1">
            <div class="stat-card">
                <div class="stat-card-header">
                    <div class="stat-icon primary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    </div>
                </div>
                <div class="stat-value">@Model.Stats.TotalApplications</div>
                <div class="stat-label">Applications Sent</div>
                <div class="stat-description">Track your application progress</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-card-header">
                    <div class="stat-icon success">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    </div>
                    <span class="stat-trend positive">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5"></polyline></svg>
                        +12% this month
                    </span>
                </div>
                <div class="stat-value">@Model.Stats.PendingApplications</div>
                <div class="stat-label">Pending Review</div>
                <div class="stat-description">Awaiting employer response</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-card-header">
                    <div class="stat-icon warning">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                    </div>
                </div>
                <div class="stat-value">@Model.Stats.SavedJobs</div>
                <div class="stat-label">Saved Jobs</div>
                <div class="stat-description">Jobs you've bookmarked</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-card-header">
                    <div class="stat-icon info">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    </div>
                </div>
                <div class="stat-value">@Model.Stats.InterviewsScheduled</div>
                <div class="stat-label">Interviews</div>
                <div class="stat-description">Upcoming interviews</div>
            </div>
        </div>
    }

    <div class="dashboard-grid">
        <div class="dashboard-main">
            <section class="dashboard-section animate-slide-up stagger-2">
                <div class="section-header d-flex justify-between items-center">
                    <div>
                        <h2 class="section-title">Recent Job Matches</h2>
                        <p class="section-subtitle">Jobs recommended based on your profile</p>
                    </div>
                    <a href="@Url.Action("Index", "Jobs")" class="btn btn-sm btn-outline-secondary">View All</a>
                </div>
                
                @if (Model.RecentJobs?.Any() == true)
                {
                    <div class="jobs-list">
                        @foreach (var job in Model.RecentJobs.Take(5))
                        {
                            <partial name="_JobCard" model="job" />
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <h3>No job matches yet</h3>
                        <p>Complete your profile to get personalized job recommendations.</p>
                        <a href="@Url.Action("Index", "Jobs")" class="btn btn-primary">Browse Jobs</a>
                    </div>
                }
            </section>

            <section class="dashboard-section animate-slide-up stagger-3">
                <div class="section-header d-flex justify-between items-center">
                    <div>
                        <h2 class="section-title">Recent Applications</h2>
                        <p class="section-subtitle">Track the status of your applications</p>
                    </div>
                    <a href="@Url.Action("Applications")" class="btn btn-sm btn-outline-secondary">View All</a>
                </div>
                
                @if (Model.RecentApplications?.Any() == true)
                {
                    <div class="table-container">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Job Title</th>
                                    <th>Company</th>
                                    <th>Applied</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in Model.RecentApplications.Take(5))
                                {
                                    <tr>
                                        <td>
                                            <a href="@Url.Action("Details", "Jobs", new { id = app.JobId })" class="table-cell-link">@app.JobTitle</a>
                                        </td>
                                        <td>@app.CompanyName</td>
                                        <td>@app.AppliedAt.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(app.Status)">@app.Status</span>
                                        </td>
                                        <td>
                                            <a href="@Url.Action("Details", "Jobs", new { id = app.JobId })" class="table-action-btn" aria-label="View application">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        <h3>No applications yet</h3>
                        <p>Start applying to jobs to see them here.</p>
                        <a href="@Url.Action("Index", "Jobs")" class="btn btn-primary">Browse Jobs</a>
                    </div>
                }
            </section>
        </div>

        <div class="dashboard-sidebar">
            <div class="card animate-slide-up stagger-4">
                <div class="card-header">
                    <h3 class="card-title">Quick Actions</h3>
                </div>
                <div class="card-body">
                    <div class="quick-actions">
                        <a href="@Url.Action("Index", "Jobs")" class="quick-action">
                            <div class="quick-action-icon primary">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            </div>
                            <div class="quick-action-content">
                                <div class="quick-action-title">Browse Jobs</div>
                                <div class="quick-action-desc">Discover new opportunities</div>
                            </div>
                        </a>
                        <a href="@Url.Action("SavedJobs")" class="quick-action">
                            <div class="quick-action-icon warning">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                            </div>
                            <div class="quick-action-content">
                                <div class="quick-action-title">Saved Jobs</div>
                                <div class="quick-action-desc">@(Model.Stats?.SavedJobs ?? 0) saved</div>
                            </div>
                        </a>
                        <a href="@Url.Action("Applications")" class="quick-action">
                            <div class="quick-action-icon success">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                            </div>
                            <div class="quick-action-content">
                                <div class="quick-action-title">My Applications</div>
                                <div class="quick-action-desc">@(Model.Stats?.TotalApplications ?? 0) sent</div>
                            </div>
                        </a>
                        <a href="@Url.Action("Interviews")" class="quick-action">
                            <div class="quick-action-icon info">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            </div>
                            <div class="quick-action-content">
                                <div class="quick-action-title">Interviews</div>
                                <div class="quick-action-desc">@(Model.Stats?.InterviewsScheduled ?? 0) scheduled</div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <div class="card animate-slide-up stagger-5 mt-4">
                <div class="card-header">
                    <h3 class="card-title">Profile Completion</h3>
                </div>
                <div class="card-body">
                    <div class="profile-completion">
                        <div class="completion-circle">
                            <svg viewBox="0 0 36 36" class="completion-svg">
                                <circle cx="18" cy="18" r="15.915" class="completion-bg" />
                                <circle cx="18" cy="18" r="15.915" class="completion-progress" style="stroke-dashoffset: @(100 - (Model.Stats?.ProfileViews ?? 0))" />
                            </svg>
                            <span class="completion-percentage">@(Model.Stats?.ProfileViews ?? 0)%</span>
                        </div>
                        <p class="completion-text">Complete your profile to get better job matches</p>
                        <a href="@Url.Action("Profile", "Account")" class="btn btn-primary w-full mt-3">Complete Profile</a>
                    </div>
                </div>
            </div>

            <div class="card animate-slide-up stagger-6 mt-4">
                <div class="card-header">
                    <h3 class="card-title">Tips for Success</h3>
                </div>
                <div class="card-body">
                    <ul class="tips-list">
                        <li class="tip-item">
                            <div class="tip-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            </div>
                            <div class="tip-content">
                                <strong>Keep your profile updated</strong>
                                <p>Employers search for candidates with complete profiles</p>
                            </div>
                        </li>
                        <li class="tip-item">
                            <div class="tip-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
                            </div>
                            <div class="tip-content">
                                <strong>Set job alerts</strong>
                                <p>Get notified when new matching jobs are posted</p>
                            </div>
                        </li>
                        <li class="tip-item">
                            <div class="tip-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                            </div>
                            <div class="tip-content">
                                <strong>Add skills to your profile</strong>
                                <p>Skills help match you with relevant jobs</p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "badge-warning",
            "reviewed" => "badge-info",
            "shortlisted" => "badge-primary",
            "interviewed" => "badge-success",
            "rejected" => "badge-danger",
            "accepted" => "badge-success",
            _ => "badge-secondary"
        };
    }
}

<style>
.dashboard-page {
    padding: 0;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 1.5rem;
}

.dashboard-section {
    margin-bottom: 2rem;
}

.section-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
}

.section-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
}

.section-subtitle {
    font-size: 0.875rem;
    color: var(--text-tertiary);
}

.jobs-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.empty-state {
    text-align: center;
    padding: 3rem 2rem;
    color: var(--text-tertiary);
    background: var(--bg-secondary);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-primary);
}

.empty-state svg {
    margin-bottom: 1rem;
    opacity: 0.5;
}

.empty-state h3 {
    font-size: 1.125rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
}

.empty-state p {
    margin-bottom: 1.5rem;
}

.quick-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.quick-action {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-fast);
}

.quick-action:hover {
    background: var(--bg-tertiary);
    border-color: var(--color-primary);
    transform: translateX(4px);
}

.quick-action-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
}

.quick-action-icon.primary { background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light)); }
.quick-action-icon.success { background: linear-gradient(135deg, var(--color-success), #34d399); }
.quick-action-icon.warning { background: linear-gradient(135deg, var(--color-warning), #fbbf24); }
.quick-action-icon.info { background: linear-gradient(135deg, var(--color-info), #22d3ee); }

.quick-action-title {
    font-weight: 600;
    color: var(--text-primary);
}

.quick-action-desc {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
}

.profile-completion {
    text-align: center;
}

.completion-circle {
    position: relative;
    width: 120px;
    height: 120px;
    margin: 0 auto 1rem;
}

.completion-svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
}

.completion-bg {
    fill: none;
    stroke: var(--border-primary);
    stroke-width: 8;
}

.completion-progress {
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 8;
    stroke-linecap: round;
    stroke-dasharray: 100;
    transition: stroke-dashoffset 1s ease-out;
}

.completion-percentage {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
}

.completion-text {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    margin-bottom: 1rem;
}

.tips-list {
    list-style: none;
}

.tip-item {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border-primary);
}

.tip-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.tip-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: rgba(var(--color-primary-rgb), 0.15);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.tip-content strong {
    display: block;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
}

.tip-content p {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin: 0;
}

@@media (max-width: 1024px) {
    .dashboard-grid {
        grid-template-columns: 1fr;
    }
    
    .dashboard-sidebar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }
}

@@media (max-width: 640px) {
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .dashboard-sidebar {
        grid-template-columns: 1fr;
    }
    
    .page-header {
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start;
    }
}
</style>