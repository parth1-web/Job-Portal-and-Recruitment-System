@model JobPortal.MVC.Models.PagedResult<JobPortal.MVC.Models.JobListDto>
@{
    ViewData["Title"] = "Saved Jobs";
}

<div class="animate-fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <span class="page-title-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                </span>
                Saved Jobs
            </h1>
            <p class="page-subtitle">Jobs you bookmarked for later</p>
        </div>
    </div>

    @if (Model?.Items?.Any() == true)
    {
        <div class="data-grid">
            @foreach (var job in Model.Items)
            {
                <partial name="_JobCard" model="job" />
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination" aria-label="Pagination">
                @if (Model.HasPreviousPage)
                {
                    <a class="page-link" href="@Url.Action("SavedJobs", new { page = Model.Page - 1 })">Previous</a>
                }
                <span class="page-link active">@Model.Page of @Model.TotalPages</span>
                @if (Model.HasNextPage)
                {
                    <a class="page-link" href="@Url.Action("SavedJobs", new { page = Model.Page + 1 })">Next</a>
                }
            </nav>
        }
    }
    else
    {
        <div class="card"><div class="card-body text-center">
            <h3 class="text-primary">No saved jobs</h3>
            <p class="text-tertiary">Tap the bookmark icon on any job to save it here.</p>
            <a href="@Url.Action("Index", "Jobs")" class="btn btn-primary mt-3">Browse Jobs</a>
        </div></div>
    }
</div>
