@model JobPortal.MVC.Models.CandidateProfileDto
@{
    ViewData["Title"] = "Create Profile";
}

<div class="animate-fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">Create Your Profile</h1>
            <p class="page-subtitle">Complete your profile to get matched with jobs</p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="card mb-4"><div class="card-body" style="border-left: 4px solid var(--color-danger);">@TempData["ErrorMessage"]</div></div>
    }

    <div class="card" style="max-width: 720px;">
        <div class="card-body">
            <partial name="_ProfileForm" model="Model" />
        </div>
    </div>
</div>
