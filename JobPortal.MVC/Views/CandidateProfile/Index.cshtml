@model JobPortal.MVC.Models.CandidateProfileDto
@{
    ViewData["Title"] = "My Profile";
    var resumes = ViewData["Resumes"] as List<JobPortal.MVC.Models.ResumeDto> ?? new List<JobPortal.MVC.Models.ResumeDto>();
}

<div class="animate-fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <span class="page-title-icon">@Model.FullName.Substring(0, 1).ToUpper()</span>
                @(string.IsNullOrEmpty(Model.FullName) ? "My Profile" : Model.FullName)
            </h1>
            <p class="page-subtitle">@Model.Headline</p>
        </div>
        <a href="@Url.Action("Edit")" class="btn btn-primary">Edit Profile</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="card mb-4"><div class="card-body" style="border-left: 4px solid var(--color-success);">@TempData["SuccessMessage"]</div></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="card mb-4"><div class="card-body" style="border-left: 4px solid var(--color-danger);">@TempData["ErrorMessage"]</div></div>
    }

    @if (string.IsNullOrEmpty(Model.FullName))
    {
        <div class="card mb-4"><div class="card-body">
            <h3 class="text-primary">Complete your profile</h3>
            <p class="text-tertiary">Employers find complete profiles far more often.</p>
            <a href="@Url.Action("Create")" class="btn btn-primary mt-3">Create Profile</a>
        </div></div>
    }

    <div class="card">
        <div class="card-header"><h3 class="card-title">About</h3></div>
        <div class="card-body">
            <dl class="detail-list">
                <div><dt>Email</dt><dd>@Model.Email</dd></div>
                <div><dt>Phone</dt><dd>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</dd></div>
                <div><dt>Location</dt><dd>@(string.IsNullOrEmpty(Model.Location) ? "—" : Model.Location)</dd></div>
            </dl>
            @if (!string.IsNullOrEmpty(Model.Summary))
            {
                <p class="mt-3" style="white-space: pre-line;">@Model.Summary</p>
            }
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h3 class="card-title">Resumes</h3>
        </div>
        <div class="card-body">
            @if (resumes.Any())
            {
                <div class="table-container">
                    <table class="table">
                        <thead><tr><th>File</th><th>Default</th><th>Uploaded</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in resumes)
                            {
                                <tr>
                                    <td><a class="table-cell-link" href="@r.FileUrl" target="_blank" rel="noopener">@r.FileName</a></td>
                                    <td>@(r.IsDefault ? "Yes" : "No")</td>
                                    <td>@r.UploadedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <form method="post" asp-action="DeleteResume" asp-route-resumeId="@r.Id" data-confirm="Delete this resume?" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="table-action-btn delete" aria-label="Delete resume"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-tertiary">No resumes uploaded yet.</p>
            }

            <h4 class="mt-4 mb-2 font-medium">Add a resume</h4>
            <form method="post" asp-action="UploadResume" class="form-row" style="align-items: end;">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="FileName" class="form-label required">File Name</label>
                    <input type="text" id="FileName" name="FileName" class="form-input" placeholder="resume.pdf" required />
                </div>
                <div class="form-group">
                    <label for="FileUrl" class="form-label required">File URL</label>
                    <input type="url" id="FileUrl" name="FileUrl" class="form-input" placeholder="https://..." required />
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-outline">Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
.detail-list { display: flex; flex-direction: column; gap: 0.75rem; }
.detail-list > div { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-primary); }
.detail-list > div:last-child { border-bottom: none; padding-bottom: 0; }
.detail-list dt { color: var(--text-tertiary); font-size: 0.8125rem; }
.detail-list dd { color: var(--text-primary); font-weight: 500; text-align: right; }
</style>
