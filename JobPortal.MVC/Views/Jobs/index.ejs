<%- include('../layout/header') %>

<div class="jobs-page animate-fade-in" style="max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem;">
    <div class="page-header" style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 class="page-title" style="font-size: 2rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem;">
                Browse Jobs
            </h1>
            <p class="page-subtitle" style="color: var(--text-tertiary); margin: 0;">Showing <%= locals.filteredJobs.length %> available opportunities with categorized visual themes</p>
        </div>
    </div>

    <!-- Category Filter Chips Bar -->
    <div class="category-filter-bar" role="tablist" aria-label="Job categories">
        <a href="/jobs<%= locals.filter.searchTerm ? '?searchTerm=' + encodeURIComponent(locals.filter.searchTerm) : '' %>" 
           class="category-filter-chip <%= (!locals.filter.category || locals.filter.category === 'all') ? 'active' : '' %>"
           role="tab"
           aria-selected="<%= (!locals.filter.category || locals.filter.category === 'all') ? 'true' : 'false' %>">
            <span>All Categories</span>
        </a>
        <% if (locals.JOB_CATEGORIES) { %>
            <% Object.values(locals.JOB_CATEGORIES).forEach(cat => { %>
                <% const isActive = locals.filter.category === cat.key || locals.filter.category === cat.label; %>
                <a href="/jobs?category=<%= encodeURIComponent(cat.key) %><%= locals.filter.searchTerm ? '&searchTerm=' + encodeURIComponent(locals.filter.searchTerm) : '' %>"
                   class="category-filter-chip job-theme-<%= cat.key %> <%= isActive ? 'active' : '' %>"
                   role="tab"
                   aria-selected="<%= isActive ? 'true' : 'false' %>">
                    <span class="job-category-dot"></span>
                    <%- cat.iconSvg %>
                    <span><%= cat.label %></span>
                </a>
            <% }) %>
        <% } %>
    </div>

    <div class="jobs-layout" style="display: grid; grid-template-columns: 280px 1fr; gap: 2rem; align-items: start;">
        <aside class="filters-sidebar" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.5rem; position: sticky; top: calc(var(--header-height) + 1rem);">
            <div class="filter-header d-flex justify-between items-center" style="margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-primary);">
                <h3 class="filter-title" style="font-size: 1.125rem; font-weight: 600; margin: 0; color: var(--text-primary);">Filters</h3>
                <a href="/jobs" class="btn btn-ghost btn-sm" style="font-size: 0.8125rem;">Reset</a>
            </div>
            
            <form method="get" action="/jobs" class="filters-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
                <div class="filter-group">
                    <label class="filter-label" style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--text-primary); margin-bottom: 0.375rem;">Keywords</label>
                    <input type="text" name="searchTerm" class="form-input" placeholder="Title, company, skill..." value="<%= locals.filter.searchTerm || '' %>" style="width: 100%;" />
                </div>
                
                <div class="filter-group">
                    <label class="filter-label" style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--text-primary); margin-bottom: 0.375rem;">Category</label>
                    <select name="category" class="form-select" style="width: 100%;">
                        <option value="">All Categories</option>
                        <% if (locals.JOB_CATEGORIES) { %>
                            <% Object.values(locals.JOB_CATEGORIES).forEach(cat => { %>
                                <option value="<%= cat.key %>" <%= (locals.filter.category === cat.key || locals.filter.category === cat.label) ? 'selected' : '' %>><%= cat.label %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label" style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--text-primary); margin-bottom: 0.375rem;">Location</label>
                    <input type="text" name="location" class="form-input" placeholder="City, state, remote..." value="<%= locals.filter.location || '' %>" style="width: 100%;" />
                </div>
                
                <div class="filter-group">
                    <label class="filter-label" style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--text-primary); margin-bottom: 0.375rem;">Work Mode</label>
                    <select name="workMode" class="form-select" style="width: 100%;">
                        <option value="">All Types</option>
                        <option value="Remote" <%= locals.filter.workMode === 'Remote' ? 'selected' : '' %>>Remote</option>
                        <option value="Hybrid" <%= locals.filter.workMode === 'Hybrid' ? 'selected' : '' %>>Hybrid</option>
                        <option value="OnSite" <%= locals.filter.workMode === 'OnSite' ? 'selected' : '' %>>On-Site</option>
                    </select>
                </div>
                
                <div class="filter-group">
                    <label class="filter-label" style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--text-primary); margin-bottom: 0.375rem;">Employment Type</label>
                    <select name="employmentType" class="form-select" style="width: 100%;">
                        <option value="">All Types</option>
                        <option value="FullTime" <%= locals.filter.employmentType === 'FullTime' ? 'selected' : '' %>>Full Time</option>
                        <option value="Contract" <%= locals.filter.employmentType === 'Contract' ? 'selected' : '' %>>Contract</option>
                        <option value="PartTime" <%= locals.filter.employmentType === 'PartTime' ? 'selected' : '' %>>Part Time</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label" style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--text-primary); margin-bottom: 0.375rem;">Min Salary ($ / yr)</label>
                    <input type="number" name="minSalary" class="form-input" placeholder="e.g. 100000" step="5000" value="<%= locals.filter.minSalary || '' %>" style="width: 100%;" />
                </div>
                
                <button type="submit" class="btn btn-primary w-full" style="margin-top: 0.5rem;">Apply Filters</button>
            </form>
        </aside>

        <section class="jobs-results">
            <% if (locals.filteredJobs && locals.filteredJobs.length > 0) { %>
                <div class="jobs-grid" style="display: flex; flex-direction: column; gap: 1.25rem;">
                    <% locals.filteredJobs.forEach(job => { %>
                        <% const theme = locals.getCategoryTheme ? locals.getCategoryTheme(job.category) : { key: 'other', label: job.category || 'General', iconSvg: '' }; %>
                        <article class="job-card job-theme-<%= theme.key %>" data-job-id="<%= job.id %>" data-job-theme="<%= theme.key %>" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.5rem; transition: all 0.2s ease;">
                            <div class="job-card-header" style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
                                <div class="job-company" style="display: flex; gap: 1rem; align-items: center;">
                                    <div class="company-logo placeholder" style="width: 48px; height: 48px; border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; flex-shrink: 0;">
                                        <%= job.companyName.charAt(0).toUpperCase() %>
                                    </div>
                                    <div>
                                        <h3 class="job-title" style="margin: 0; font-size: 1.2rem; font-weight: 600;">
                                            <a href="/jobs/<%= job.id %>" style="color: var(--text-primary); text-decoration: none;"><%= job.title %></a>
                                        </h3>
                                        <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.35rem;">
                                            <span style="color: var(--text-tertiary); font-size: 0.875rem;"><%= job.companyName %></span>
                                            <span class="job-category-badge" title="Category: <%= theme.label %>">
                                                <span class="job-category-dot"></span>
                                                <%- theme.iconSvg %>
                                                <span><%= theme.label %></span>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <button class="btn btn-icon btn-ghost save-job-btn <%= job.isSaved ? 'saved' : '' %>" 
                                        data-job-id="<%= job.id %>" 
                                        aria-label="Save job"
                                        onclick="saveJob('<%= job.id %>')">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="<%= job.isSaved ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                                </button>
                            </div>
                            
                            <div style="margin: 1rem 0;">
                                <div class="job-meta" style="display: flex; flex-wrap: wrap; gap: 1.25rem; font-size: 0.875rem; color: var(--text-tertiary); margin-bottom: 0.75rem;">
                                    <span style="display: inline-flex; align-items: center; gap: 0.375rem;">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                        <%= job.location %>
                                    </span>
                                    <span style="display: inline-flex; align-items: center; gap: 0.375rem;">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line></svg>
                                        <%= job.workMode %>
                                    </span>
                                    <span style="display: inline-flex; align-items: center; gap: 0.375rem;">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                                        <%= job.employmentType %>
                                    </span>
                                    <% if (job.minSalary && job.maxSalary) { %>
                                        <span style="display: inline-flex; align-items: center; gap: 0.375rem; font-weight: 600; color: var(--color-success);">
                                            $<%= Number(job.minSalary).toLocaleString() %> - $<%= Number(job.maxSalary).toLocaleString() %> / yr
                                        </span>
                                    <% } %>
                                </div>
                                <p style="color: var(--text-secondary); font-size: 0.9375rem; line-height: 1.5; margin-bottom: 0.75rem;">
                                    <%= job.description.split('\n')[0] %>
                                </p>
                                <% if (job.skills && job.skills.length > 0) { %>
                                    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                                        <% job.skills.forEach(skill => { %>
                                            <span class="badge badge-soft"><%= skill %></span>
                                        <% }) %>
                                    </div>
                                <% } %>
                            </div>
                            
                            <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 1rem; border-top: 1px solid var(--border-primary);">
                                <span style="font-size: 0.8125rem; color: var(--text-tertiary);">
                                    Posted <%= new Date(job.postedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %> &middot; <%= job.applicationsCount %> applicants
                                </span>
                                <div class="d-flex gap-2">
                                    <a href="/jobs/<%= job.id %>" class="btn btn-primary btn-sm">View & Apply</a>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state" style="text-align: center; padding: 4rem 2rem; background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl);">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--text-tertiary); margin-bottom: 1rem;">
                        <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem;">No jobs match your criteria</h3>
                    <p style="color: var(--text-tertiary); margin-bottom: 1.5rem;">Try widening your search terms or clearing some filters.</p>
                    <a href="/jobs" class="btn btn-outline-secondary">Clear All Filters</a>
                </div>
            <% } %>
        </section>
    </div>
</div>

<%- include('../layout/footer') %>
