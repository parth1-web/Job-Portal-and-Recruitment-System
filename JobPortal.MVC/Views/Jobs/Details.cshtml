@model JobPortal.MVC.Models.JobDetailDto
@{
    ViewData["Title"] = Model.Title;
    var salary = "";
    if (Model.MinSalary.HasValue || Model.MaxSalary.HasValue)
    {
        var min = Model.MinSalary?.ToString("N0") ?? "Negotiable";
        var max = Model.MaxSalary?.ToString("N0") ?? "Negotiable";
        salary = $"{(Model.Currency == "USD" ? "$" : Model.Currency)} {min} - {max}";
    }
}

<div class="animate-fade-in">
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <span class="breadcrumb-item"><a class="breadcrumb-link" href="@Url.Action("Index", "Home")">Home</a></span>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-item"><a class="breadcrumb-link" href="@Url.Action("Index", "Jobs")">Jobs</a></span>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">@Model.Title</span>
    </nav>

    <div class="job-detail-layout">
        <div class="job-detail-main">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex gap-4 items-start flex-wrap">
                        @if (!string.IsNullOrEmpty(Model.CompanyLogoUrl))
                        {
                            <img src="@Model.CompanyLogoUrl" alt="@Model.CompanyName" class="avatar avatar-xl" />
                        }
                        else
                        {
                            <div class="avatar avatar-xl">@Model.CompanyName.Substring(0, 1).ToUpper()</div>
                        }
                        <div class="flex-1 min-w-0">
                            <h1 class="text-2xl font-bold text-primary">@Model.Title</h1>
                            <p class="text-tertiary">@Model.CompanyName &middot; @Model.Location</p>
                            <div class="d-flex gap-2 flex-wrap mt-2">
                                <span class="badge badge-primary">@Model.WorkMode</span>
                                <span class="badge badge-secondary">@Model.EmploymentType</span>
                                <span class="badge badge-soft">@Model.Status</span>
                            </div>
                        </div>
                        <button class="btn btn-icon btn-ghost save-job-btn @(Model.IsSaved ? "saved" : "")"
                                data-job-id="@Model.Id"
                                aria-label="Save job"
                                onclick="saveJob('@Model.Id')">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(salary))
                    {
                        <p class="text-success font-semibold text-lg mt-3">@salary per year</p>
                    }
                    <p class="text-sm text-muted mt-1">Posted @Model.PostedDate.ToString("MMM dd, yyyy") &middot; @Model.ApplicationsCount applicants &middot; @Model.ViewsCount views</p>

                    @if (Model.Skills?.Any() == true)
                    {
                        <div class="d-flex gap-2 flex-wrap mt-3">
                            @foreach (var skill in Model.Skills)
                            {
                                <span class="badge badge-soft">@skill</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header"><h3 class="card-title">Job Description</h3></div>
                <div class="card-body"><p style="white-space: pre-line;">@Model.Description</p></div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Requirements))
            {
                <div class="card mt-4">
                    <div class="card-header"><h3 class="card-title">Requirements</h3></div>
                    <div class="card-body"><p style="white-space: pre-line;">@Model.Requirements</p></div>
                </div>
            }

            @if (Model.Responsibilities?.Any() == true)
            {
                <div class="card mt-4">
                    <div class="card-header"><h3 class="card-title">Responsibilities</h3></div>
                    <div class="card-body">
                        <ul class="list-disc" style="padding-left: 1.25rem;">
                            @foreach (var r in Model.Responsibilities)
                            {
                                <li class="mb-2">@r</li>
                            }
                        </ul>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Benefits))
            {
                <div class="card mt-4">
                    <div class="card-header"><h3 class="card-title">Benefits</h3></div>
                    <div class="card-body"><p style="white-space: pre-line;">@Model.Benefits</p></div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.CompanyDescription))
            {
                <div class="card mt-4">
                    <div class="card-header"><h3 class="card-title">About @Model.CompanyName</h3></div>
                    <div class="card-body">
                        <p>@Model.CompanyDescription</p>
                        @if (!string.IsNullOrEmpty(Model.CompanyWebsite))
                        {
                            <p class="mt-2"><a href="@Model.CompanyWebsite" target="_blank" rel="noopener">@Model.CompanyWebsite</a></p>
                        }
                    </div>
                </div>
            }
        </div>

        <aside class="job-detail-side">
            <div class="card">
                <div class="card-header"><h3 class="card-title">Apply for this job</h3></div>
                <div class="card-body">
                    @if (Model.HasApplied)
                    {
                        <div class="d-flex items-center gap-2">
                            <span class="badge badge-success">Applied</span>
                            @if (!string.IsNullOrEmpty(Model.ApplicationStatus))
                            {
                                <span class="text-sm text-tertiary">@Model.ApplicationStatus</span>
                            }
                        </div>
                        @if (Model.AppliedAt.HasValue)
                        {
                            <p class="text-sm text-muted mt-2">Applied on @Model.AppliedAt.Value.ToString("MMM dd, yyyy")</p>
                        }
                    }
                    else if (User.Identity?.IsAuthenticated == true)
                    {
                        <form id="applyForm">
                            @Html.AntiForgeryToken()
                            <div class="form-group">
                                <label for="CoverLetter" class="form-label">Cover Letter</label>
                                <textarea id="CoverLetter" name="CoverLetter" class="form-textarea" rows="5" maxlength="2000" placeholder="Why are you a great fit for this role?"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary w-full">Submit Application</button>
                        </form>
                    }
                    else
                    {
                        <p class="text-tertiary mb-3">Sign in as a candidate to apply for this position.</p>
                        <a href="@Url.Action("Login", "Auth", new { returnUrl = Context.Request.Path })" class="btn btn-primary w-full">Sign In to Apply</a>
                    }
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header"><h3 class="card-title">Job Overview</h3></div>
                <div class="card-body">
                    <dl class="detail-list">
                        <div><dt>Location</dt><dd>@Model.Location</dd></div>
                        <div><dt>Work mode</dt><dd>@Model.WorkMode</dd></div>
                        <div><dt>Job type</dt><dd>@Model.EmploymentType</dd></div>
                        @if (Model.ExpiryDate.HasValue)
                        {
                            <div><dt>Deadline</dt><dd>@Model.ExpiryDate.Value.ToString("MMM dd, yyyy")</dd></div>
                        }
                    </dl>
                </div>
            </div>
        </aside>
    </div>
</div>

<style>
.job-detail-layout { display: grid; grid-template-columns: 1fr 320px; gap: 1.5rem; margin-top: 1.5rem; align-items: start; }
.job-detail-side { position: sticky; top: calc(var(--header-height) + 1.5rem); display: flex; flex-direction: column; gap: 0; }
.detail-list { display: flex; flex-direction: column; gap: 0.75rem; }
.detail-list > div { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-primary); }
.detail-list > div:last-child { border-bottom: none; padding-bottom: 0; }
.detail-list dt { color: var(--text-tertiary); font-size: 0.8125rem; }
.detail-list dd { color: var(--text-primary); font-weight: 500; text-align: right; }
@@media (max-width: 900px) {
  .job-detail-layout { grid-template-columns: 1fr; }
  .job-detail-side { position: static; }
}
</style>

@section Scripts {
    <script>
        document.getElementById('applyForm')?.addEventListener('submit', function (e) {
            e.preventDefault();
            applyToJob('@Model.Id', new FormData(this));
        });
    </script>
}
