@model JobPortal.MVC.Models.CreateInterviewRequest
@{
    ViewData["Title"] = "Schedule Interview";
    var jobId = ViewData["JobId"]?.ToString();
}

<div class="animate-fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">Schedule Interview</h1>
            <p class="page-subtitle">Pick a time and share a meeting link</p>
        </div>
        <a href="@Url.Action("Applications", new { jobId })" class="btn btn-outline-secondary">Back to Applications</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="card mb-4"><div class="card-body" style="border-left: 4px solid var(--color-danger);">@TempData["ErrorMessage"]</div></div>
    }

    <div class="card" style="max-width: 640px;">
        <div class="card-body">
            <form method="post" asp-action="ScheduleInterview" asp-route-jobId="@jobId">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ApplicationId" value="@Model.ApplicationId" />
                <div class="form-row">
                    <div class="form-group">
                        <label for="ScheduledAt" class="form-label required">Date &amp; Time</label>
                        <input type="datetime-local" id="ScheduledAt" name="ScheduledAt" class="form-input" value="@Model.ScheduledAt.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                    <div class="form-group">
                        <label for="DurationMinutes" class="form-label required">Duration (minutes)</label>
                        <input type="number" id="DurationMinutes" name="DurationMinutes" class="form-input" value="@Model.DurationMinutes" min="15" max="480" step="15" required />
                    </div>
                </div>
                <div class="form-group">
                    <label for="MeetingLink" class="form-label">Meeting Link</label>
                    <input type="url" id="MeetingLink" name="MeetingLink" class="form-input" value="@Model.MeetingLink" placeholder="https://meet.example.com/..." />
                </div>
                <div class="form-group">
                    <label for="Notes" class="form-label">Notes for the Candidate</label>
                    <textarea id="Notes" name="Notes" class="form-textarea" rows="4" maxlength="1000">@Model.Notes</textarea>
                </div>
                <button type="submit" class="btn btn-primary">Schedule Interview</button>
            </form>
        </div>
    </div>
</div>
