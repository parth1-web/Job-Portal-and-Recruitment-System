@model JobPortal.MVC.Models.PagedResult<JobPortal.MVC.Models.JobListDto>
@{
    ViewData["Title"] = "My Jobs";
    var statusFilter = ViewData["StatusFilter"]?.ToString();
}

<div class="animate-fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <span class="page-title-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                </span>
                My Jobs
            </h1>
            <p class="page-subtitle">Manage your job postings</p>
        </div>
        <a href="@Url.Action("Create", "EmployerJobs")" class="btn btn-primary">Post a Job</a>
    </div>

    <div class="filter-bar">
        <div class="filter-group">
            <span class="filter-label">Status</span>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-sm @(string.IsNullOrEmpty(statusFilter) ? "btn-primary" : "btn-outline-secondary")" href="@Url.Action("Jobs")">All</a>
                <a class="btn btn-sm @(statusFilter == "Published" ? "btn-primary" : "btn-outline-secondary")" href="@Url.Action("Jobs", new { status = "Published" })">Published</a>
                <a class="btn btn-sm @(statusFilter == "Draft" ? "btn-primary" : "btn-outline-secondary")" href="@Url.Action("Jobs", new { status = "Draft" })">Draft</a>
                <a class="btn btn-sm @(statusFilter == "Closed" ? "btn-primary" : "btn-outline-secondary")" href="@Url.Action("Jobs", new { status = "Closed" })">Closed</a>
            </div>
        </div>
    </div>

    @if (Model?.Items?.Any() == true)
    {
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr><th>Title</th><th>Status</th><th>Applications</th><th>Posted</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.Items)
                    {
                        <tr>
                            <td><a class="table-cell-link" href="@Url.Action("Details", "EmployerJobs", new { id = job.Id })">@job.Title</a></td>
                            <td><span class="badge badge-soft">@job.Status</span></td>
                            <td>@job.ApplicationsCount</td>
                            <td>@job.PostedDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <div class="table-actions">
                                    <a class="table-action-btn" aria-label="View applications" href="@Url.Action("Applications", new { jobId = job.Id })"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg></a>
                                    <a class="table-action-btn" aria-label="Edit job" href="@Url.Action("Edit", "EmployerJobs", new { id = job.Id })"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination" aria-label="Pagination">
                @if (Model.HasPreviousPage)
                {
                    <a class="page-link" href="@Url.Action("Jobs", new { page = Model.Page - 1, status = statusFilter })">Previous</a>
                }
                <span class="page-link active">@Model.Page of @Model.TotalPages</span>
                @if (Model.HasNextPage)
                {
                    <a class="page-link" href="@Url.Action("Jobs", new { page = Model.Page + 1, status = statusFilter })">Next</a>
                }
            </nav>
        }
    }
    else
    {
        <div class="card"><div class="card-body text-center">
            <h3 class="text-primary">No jobs yet</h3>
            <p class="text-tertiary">Post your first job to start receiving applications.</p>
            <a href="@Url.Action("Create", "EmployerJobs")" class="btn btn-primary mt-3">Post a Job</a>
        </div></div>
    }
</div>
