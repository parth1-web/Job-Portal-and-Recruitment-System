@model JobPortal.MVC.Models.PagedResult<JobPortal.MVC.Models.InterviewDto>
@{
    ViewData["Title"] = "Interviews";
}

<div class="animate-fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <span class="page-title-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                </span>
                Interviews
            </h1>
            <p class="page-subtitle">Scheduled interviews with candidates</p>
        </div>
    </div>

    @if (Model?.Items?.Any() == true)
    {
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr><th>Candidate</th><th>Job</th><th>Scheduled</th><th>Meeting</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var iv in Model.Items)
                    {
                        <tr>
                            <td>@iv.CandidateName</td>
                            <td>@iv.JobTitle</td>
                            <td>@iv.ScheduledAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(iv.MeetingLink))
                                {
                                    <a class="table-cell-link" href="@iv.MeetingLink" target="_blank" rel="noopener">Join</a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><span class="badge badge-primary">@iv.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination" aria-label="Pagination">
                @if (Model.HasPreviousPage)
                {
                    <a class="page-link" href="@Url.Action("Interviews", new { page = Model.Page - 1 })">Previous</a>
                }
                <span class="page-link active">@Model.Page of @Model.TotalPages</span>
                @if (Model.HasNextPage)
                {
                    <a class="page-link" href="@Url.Action("Interviews", new { page = Model.Page + 1 })">Next</a>
                }
            </nav>
        }
    }
    else
    {
        <div class="card"><div class="card-body text-center">
            <h3 class="text-primary">No interviews scheduled</h3>
            <p class="text-tertiary">Schedule interviews from the Applications page.</p>
            <a href="@Url.Action("Applications")" class="btn btn-primary mt-3">View Applications</a>
        </div></div>
    }
</div>
