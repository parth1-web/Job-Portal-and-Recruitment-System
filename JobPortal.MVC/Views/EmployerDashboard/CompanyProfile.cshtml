@model JobPortal.MVC.Models.EmployerProfileDto
@{
    ViewData["Title"] = "Company Profile";
}

<div class="animate-fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <span class="page-title-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"></path><path d="M5 21V7l7-4 7 4v14"></path><path d="M9 9h.01"></path><path d="M9 12h.01"></path><path d="M9 15h.01"></path><path d="M15 9h.01"></path><path d="M15 12h.01"></path><path d="M15 15h.01"></path></svg>
                </span>
                Company Profile
            </h1>
            <p class="page-subtitle">This is what candidates see about your company</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="card mb-4"><div class="card-body" style="border-left: 4px solid var(--color-success);">@TempData["SuccessMessage"]</div></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="card mb-4"><div class="card-body" style="border-left: 4px solid var(--color-danger);">@TempData["ErrorMessage"]</div></div>
    }

    <div class="card">
        <div class="card-body">
            <form method="post" asp-action="UpdateCompanyProfile">
                @Html.AntiForgeryToken()
                <div class="form-row">
                    <div class="form-group">
                        <label for="CompanyName" class="form-label required">Company Name</label>
                        <input type="text" id="CompanyName" name="CompanyName" class="form-input" value="@Model.CompanyName" required />
                    </div>
                    <div class="form-group">
                        <label for="Website" class="form-label">Website</label>
                        <input type="url" id="Website" name="Website" class="form-input" value="@Model.Website" placeholder="https://example.com" />
                    </div>
                </div>
                <div class="form-group">
                    <label for="Description" class="form-label">Description</label>
                    <textarea id="Description" name="Description" class="form-textarea" rows="4">@Model.Description</textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="Industry" class="form-label">Industry</label>
                        <input type="text" id="Industry" name="Industry" class="form-input" value="@Model.Industry" />
                    </div>
                    <div class="form-group">
                        <label for="Location" class="form-label">Location</label>
                        <input type="text" id="Location" name="Location" class="form-input" value="@Model.Location" />
                    </div>
                </div>
                <div class="form-group">
                    <label for="CompanyLogoUrl" class="form-label">Logo URL</label>
                    <input type="url" id="CompanyLogoUrl" name="CompanyLogoUrl" class="form-input" value="@Model.CompanyLogoUrl" placeholder="https://example.com/logo.png" />
                </div>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </form>
        </div>
    </div>
</div>
