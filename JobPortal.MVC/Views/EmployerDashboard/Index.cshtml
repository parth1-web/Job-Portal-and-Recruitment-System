@model JobPortal.MVC.Controllers.EmployerDashboardViewModel
@{
    ViewData["Title"] = "Employer Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["UserRole"] = "Employer";
}

<div class="dashboard-page animate-fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <span class="page-title-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </span>
                Employer Dashboard
            </h1>
            <p class="page-subtitle">Welcome back! Here's an overview of your hiring activity.</p>
        </div>
        <div class="d-flex gap-3">
            <a href="@Url.Action("Create", "EmployerJobs")" class="btn btn-primary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Post a Job
            </a>
            <a href="@Url.Action("CompanyProfile")" class="btn btn-outline-secondary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                Company Profile
            </a>
        </div>
    </div>

    @if (Model.Stats != null)
    {
        <div class="stats-grid animate-slide-up stagger-1">
            <div class="stat-card">
                <div class="stat-card-header">
                    <div class="stat-icon primary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    </div>
                </div>
                <div class="stat-value">@Model.Stats.TotalJobs</div>
                <div class="stat-label">Total Jobs Posted</div>
                <div class="stat-description">All time job postings</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-card-header">
                    <div class="stat-icon success">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    </div>
                    <span class="stat-trend positive">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5"></polyline></svg>
                        +8% this month
                    </span>
                </div>
                <div class="stat-value">@Model.Stats.ActiveJobs</div>
                <div class="stat-label">Active Jobs</div>
                <div class="stat-description">Currently accepting applications</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-card-header">
                    <div class="stat-icon warning">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                    </div>
                </div>
                <div class="stat-value">@Model.Stats.TotalApplications</div>
                <div class="stat-label">Total Applications</div>
                <div class="stat-description">All applications received</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-card-header">
                    <div class="stat-icon info">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    </div>
                </div>
                <div class="stat-value">@Model.Stats.PendingApplications</div>
                <div class="stat-label">Pending Review</div>
                <div class="stat-description">Need your attention</div>
            </div>
        </div>
    }

    <div class="dashboard-grid">
        <div class="dashboard-main">
            <section class="dashboard-section animate-slide-up stagger-2">
                <div class="section-header d-flex justify-between items-center">
                    <div>
                        <h2 class="section-title">My Jobs</h2>
                        <p class="section-subtitle">Manage your job postings</p>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Create", "EmployerJobs")" class="btn btn-sm btn-primary">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            New Job
                        </a>
                        <a href="@Url.Action("Jobs")" class="btn btn-sm btn-outline-secondary">View All</a>
                    </div>
                </div>
                
                @if (Model.MyJobs?.Any() == true)
                {
                    <div class="table-container">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Job Title</th>
                                    <th>Status</th>
                                    <th>Type</th>
                                    <th>Applications</th>
                                    <th>Posted</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in Model.MyJobs.Take(5))
                                {
                                    <tr>
                                        <td>
                                            <a href="@Url.Action("Details", "EmployerJobs", new { id = job.Id })" class="table-cell-link">@job.Title</a>
                                        </td>
                                        <td>
                                            <span class="badge @GetJobStatusBadgeClass(job.Status)">@job.Status</span>
                                        </td>
                                        <td>
                                            <span class="badge badge-soft">@job.EmploymentType</span>
                                        </td>
                                        <td>@job.ApplicationsCount</td>
                                        <td>@job.PostedDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <div class="table-actions">
                                                <a href="@Url.Action("Details", "EmployerJobs", new { id = job.Id })" class="table-action-btn" aria-label="View job">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                                </a>
                                                <a href="@Url.Action("Applications", new { jobId = job.Id })" class="table-action-btn" aria-label="View applications">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        <h3>No jobs posted yet</h3>
                        <p>Start by posting your first job to attract top talent.</p>
                        <a href="@Url.Action("Create", "EmployerJobs")" class="btn btn-primary">Post a Job</a>
                    </div>
                }
            </section>

            <section class="dashboard-section animate-slide-up stagger-3">
                <div class="section-header d-flex justify-between items-center">
                    <div>
                        <h2 class="section-title">Recent Applications</h2>
                        <p class="section-subtitle">New applications needing review</p>
                    </div>
                    <a href="@Url.Action("Applications")" class="btn btn-sm btn-outline-secondary">View All</a>
                </div>
                
                @if (Model.RecentApplications?.Any() == true)
                {
                    <div class="table-container">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Candidate</th>
                                    <th>Job</th>
                                    <th>Applied</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in Model.RecentApplications.Take(5))
                                {
                                    <tr>
                                        <td>
                                            <div class="candidate-info">
                                                <div class="avatar avatar-sm">
                                                    @app.CandidateName.Substring(0, 1).ToUpper()
                                                </div>
                                                <div>
                                                    <div class="font-medium">@app.CandidateName</div>
                                                    <div class="text-sm text-tertiary">@app.CandidateEmail</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <a href="@Url.Action("Details", "EmployerJobs", new { id = app.JobId })" class="table-cell-link">@app.JobTitle</a>
                                        </td>
                                        <td>@app.AppliedAt.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(app.Status)">@app.Status</span>
                                        </td>
                                        <td>
                                            <div class="table-actions">
                                                <a href="@Url.Action("Applications", "EmployerDashboard", new { jobId = app.JobId })" class="table-action-btn" aria-label="View applications for this job">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                        <h3>No applications yet</h3>
                        <p>Applications will appear here once candidates apply to your jobs.</p>
                    </div>
                }
            </section>
        </div>

        <div class="dashboard-sidebar">
            <div class="card animate-slide-up stagger-4">
                <div class="card-header">
                    <h3 class="card-title">Upcoming Interviews</h3>
                </div>
                <div class="card-body">
                    @if (Model.UpcomingInterviews?.Any() == true)
                    {
                        <div class="interview-list">
                            @foreach (var interview in Model.UpcomingInterviews.Take(5))
                            {
                                <div class="interview-item">
                                    <div class="interview-date">
                                        <span class="day">@interview.ScheduledAt.ToString("dd")</span>
                                        <span class="month">@interview.ScheduledAt.ToString("MMM")</span>
                                    </div>
                                    <div class="interview-details">
                                        <div class="interview-title">@interview.JobTitle</div>
                                        <div class="interview-meta">
                                            <span>@interview.ScheduledAt.ToString("HH:mm")</span>
                                            <span>•</span>
                                            <span>@interview.DurationMinutes min</span>
                                            <span>•</span>
                                            <span class="badge badge-soft">@interview.Type</span>
                                        </div>
                                        <div class="interview-candidate">with @interview.CandidateName</div>
                                    </div>
                                    <span class="badge @GetStatusBadgeClass(interview.Status)">@interview.Status</span>
                                </div>
                            }
                        </div>
                        <a href="@Url.Action("Interviews")" class="btn btn-sm btn-outline-secondary w-full mt-3">View All Interviews</a>
                    }
                    else
                    {
                        <div class="empty-state">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            <p>No upcoming interviews</p>
                        </div>
                    }
                </div>
            </div>

            <div class="card animate-slide-up stagger-5 mt-4">
                <div class="card-header">
                    <h3 class="card-title">Quick Actions</h3>
                </div>
                <div class="card-body">
                    <div class="quick-actions">
                        <a href="@Url.Action("Create", "EmployerJobs")" class="quick-action">
                            <div class="quick-action-icon primary">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            </div>
                            <div class="quick-action-content">
                                <div class="quick-action-title">Post a Job</div>
                                <div class="quick-action-desc">Create a new job listing</div>
                            </div>
                        </a>
                        <a href="@Url.Action("Jobs")" class="quick-action">
                            <div class="quick-action-icon success">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                            </div>
                            <div class="quick-action-content">
                                <div class="quick-action-title">Manage Jobs</div>
                                <div class="quick-action-desc">@(Model.Stats?.ActiveJobs ?? 0) active jobs</div>
                            </div>
                        </a>
                        <a href="@Url.Action("Applications")" class="quick-action">
                            <div class="quick-action-icon warning">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                            </div>
                            <div class="quick-action-content">
                                <div class="quick-action-title">Review Applications</div>
                                <div class="quick-action-desc">@(Model.Stats?.PendingApplications ?? 0) pending</div>
                            </div>
                        </a>
                        <a href="@Url.Action("Interviews")" class="quick-action">
                            <div class="quick-action-icon info">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            </div>
                            <div class="quick-action-content">
                                <div class="quick-action-title">Schedule Interviews</div>
                                <div class="quick-action-desc">@(Model.Stats?.InterviewsScheduled ?? 0) scheduled</div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <div class="card animate-slide-up stagger-6 mt-4">
                <div class="card-header">
                    <h3 class="card-title">Hiring Tips</h3>
                </div>
                <div class="card-body">
                    <ul class="tips-list">
                        <li class="tip-item">
                            <div class="tip-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                            </div>
                            <div class="tip-content">
                                <strong>Write clear job descriptions</strong>
                                <p>Detailed requirements attract better candidates</p>
                            </div>
                        </li>
                        <li class="tip-item">
                            <div class="tip-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            </div>
                            <div class="tip-content">
                                <strong>Respond quickly</strong>
                                <p>Fast responses improve candidate experience</p>
                            </div>
                        </li>
                        <li class="tip-item">
                            <div class="tip-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                            </div>
                            <div class="tip-content">
                                <strong>Build your employer brand</strong>
                                <p>Complete your company profile to attract talent</p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetJobStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "published" => "badge-success",
            "draft" => "badge-secondary",
            "closed" => "badge-danger",
            "paused" => "badge-warning",
            _ => "badge-secondary"
        };
    }

    string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "badge-warning",
            "reviewed" => "badge-info",
            "shortlisted" => "badge-primary",
            "interviewed" => "badge-success",
            "rejected" => "badge-danger",
            "accepted" => "badge-success",
            "scheduled" => "badge-primary",
            "completed" => "badge-success",
            "cancelled" => "badge-danger",
            _ => "badge-secondary"
        };
    }
}

<style>
.dashboard-page {
    padding: 0;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 1.5rem;
}

.dashboard-section {
    margin-bottom: 2rem;
}

.section-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
}

.section-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
}

.section-subtitle {
    font-size: 0.875rem;
    color: var(--text-tertiary);
}

.candidate-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.interview-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.interview-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem;
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-primary);
    transition: all var(--transition-fast);
}

.interview-item:hover {
    border-color: var(--color-primary);
    background: rgba(var(--color-primary-rgb), 0.05);
}

.interview-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.5rem;
    background: var(--bg-card);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-primary);
    min-width: 56px;
}

.interview-date .day {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
}

.interview-date .month {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
}

.interview-details {
    flex: 1;
    min-width: 0;
}

.interview-title {
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
}

.interview-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
}

.interview-candidate {
    font-size: 0.8125rem;
    color: var(--text-secondary);
}

.quick-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.quick-action {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-fast);
}

.quick-action:hover {
    background: var(--bg-tertiary);
    border-color: var(--color-primary);
    transform: translateX(4px);
}

.quick-action-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
}

.quick-action-icon.primary { background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light)); }
.quick-action-icon.success { background: linear-gradient(135deg, var(--color-success), #34d399); }
.quick-action-icon.warning { background: linear-gradient(135deg, var(--color-warning), #fbbf24); }
.quick-action-icon.info { background: linear_gradent(135deg, var(--color-info), #22d3ee); }

.quick-action-title {
    font-weight: 600;
    color: var(--text-primary);
}

.quick-action-desc {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
}

.tips-list {
    list-style: none;
}

.tip-item {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border-primary);
}

.tip-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.tip-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: rgba(var(--color-primary-rgb), 0.15);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.tip-content strong {
    display: block;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
}

.tip-content p {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin: 0;
}

@@media (max-width: 1024px) {
    .dashboard-grid {
        grid-template-columns: 1fr;
    }
    
    .dashboard-sidebar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }
}

@@media (max-width: 640px) {
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
