<%- include('../layout/header') %>

<div class="dashboard-page animate-fade-in" style="max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem;">
    <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 class="page-title" style="font-size: 1.875rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.25rem 0;">
                Candidate Dashboard
            </h1>
            <p class="page-subtitle" style="color: var(--text-tertiary); margin: 0;">Welcome back, <%= locals.user.name %>! Here's your job search overview.</p>
        </div>
        <div class="d-flex gap-3">
            <a href="/jobs" class="btn btn-primary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                Browse Jobs
            </a>
            <a href="/account/profile" class="btn btn-outline-secondary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                Edit Profile
            </a>
        </div>
    </div>

    <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
        <div class="stat-card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-size: 0.875rem; font-weight: 500; color: var(--text-tertiary);">Applications Sent</span>
                <div style="width: 36px; height: 36px; border-radius: var(--radius-md); background: rgba(99, 102, 241, 0.1); color: var(--color-primary); display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                </div>
            </div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--text-primary); line-height: 1;"><%= locals.stats.totalApplications %></div>
            <div style="font-size: 0.8125rem; color: var(--text-tertiary); margin-top: 0.5rem;"><a href="/candidatedashboard/applications" style="color: var(--color-primary); text-decoration: none;">View all &rarr;</a></div>
        </div>

        <div class="stat-card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-size: 0.875rem; font-weight: 500; color: var(--text-tertiary);">Under Review</span>
                <div style="width: 36px; height: 36px; border-radius: var(--radius-md); background: rgba(245, 158, 11, 0.1); color: var(--color-warning); display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </div>
            </div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--text-primary); line-height: 1;"><%= locals.stats.pendingApplications %></div>
            <div style="font-size: 0.8125rem; color: var(--text-tertiary); margin-top: 0.5rem;">Awaiting response</div>
        </div>

        <div class="stat-card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-size: 0.875rem; font-weight: 500; color: var(--text-tertiary);">Saved Jobs</span>
                <div style="width: 36px; height: 36px; border-radius: var(--radius-md); background: rgba(16, 185, 129, 0.1); color: var(--color-success); display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                </div>
            </div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--text-primary); line-height: 1;"><%= locals.stats.savedJobs %></div>
            <div style="font-size: 0.8125rem; color: var(--text-tertiary); margin-top: 0.5rem;"><a href="/candidatedashboard/saved" style="color: var(--color-primary); text-decoration: none;">View saved &rarr;</a></div>
        </div>

        <div class="stat-card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-size: 0.875rem; font-weight: 500; color: var(--text-tertiary);">Interviews</span>
                <div style="width: 36px; height: 36px; border-radius: var(--radius-md); background: rgba(6, 182, 212, 0.1); color: var(--color-info); display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line></svg>
                </div>
            </div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--text-primary); line-height: 1;"><%= locals.stats.interviewsScheduled %></div>
            <div style="font-size: 0.8125rem; color: var(--text-tertiary); margin-top: 0.5rem;"><a href="/candidatedashboard/interviews" style="color: var(--color-primary); text-decoration: none;">View schedule &rarr;</a></div>
        </div>
    </div>

    <div class="dashboard-grid-split" style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; align-items: start;">
        <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin: 0;">Recent Applications</h2>
                <a href="/candidatedashboard/applications" style="color: var(--color-primary); text-decoration: none; font-size: 0.875rem; font-weight: 500;">View All</a>
            </div>

            <% if (locals.applications && locals.applications.length > 0) { %>
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <% locals.applications.forEach(app => { %>
                        <div class="card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-lg); padding: 1.25rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
                            <div>
                                <h3 style="margin: 0 0 0.25rem 0; font-size: 1.05rem; font-weight: 600; color: var(--text-primary);"><%= app.jobTitle %></h3>
                                <p style="margin: 0; color: var(--text-tertiary); font-size: 0.875rem;"><%= app.companyName %> &middot; Applied on <%= new Date(app.appliedDate).toLocaleDateString() %></p>
                            </div>
                            <div style="display: flex; align-items: center; gap: 1rem;">
                                <span class="badge <%= app.status === 'Interview Scheduled' ? 'badge-primary' : 'badge-soft' %>" style="font-weight: 600;">
                                    <%= app.status %>
                                </span>
                                <a href="/jobs/<%= app.jobId %>" class="btn btn-sm btn-outline-secondary">Job Info</a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div style="padding: 2.5rem; text-align: center; background: var(--bg-card); border: 1px dashed var(--border-primary); border-radius: var(--radius-xl);">
                    <p style="color: var(--text-tertiary); margin-bottom: 1rem;">You haven't submitted any applications yet.</p>
                    <a href="/jobs" class="btn btn-primary btn-sm">Explore Open Jobs</a>
                </div>
            <% } %>

            <div style="display: flex; justify-content: space-between; align-items: center; margin: 2.5rem 0 1.25rem 0;">
                <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin: 0;">Recommended For You</h2>
                <a href="/jobs" style="color: var(--color-primary); text-decoration: none; font-size: 0.875rem; font-weight: 500;">See More</a>
            </div>

            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <% locals.recommendedJobs.forEach(job => { %>
                    <div class="card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-lg); padding: 1.25rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
                        <div>
                            <h3 style="margin: 0 0 0.25rem 0; font-size: 1.05rem; font-weight: 600;">
                                <a href="/jobs/<%= job.id %>" style="color: var(--text-primary); text-decoration: none;"><%= job.title %></a>
                            </h3>
                            <p style="margin: 0; color: var(--text-tertiary); font-size: 0.875rem;"><%= job.companyName %> &middot; <%= job.location %> (<%= job.workMode %>)</p>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <% if (job.minSalary) { %>
                                <span style="font-weight: 600; color: var(--color-success); font-size: 0.875rem;">$<%= Number(job.minSalary).toLocaleString() %>+</span>
                            <% } %>
                            <a href="/jobs/<%= job.id %>" class="btn btn-sm btn-primary">Apply</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <div>
            <div class="card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.5rem; margin-bottom: 1.5rem;">
                <h3 style="font-size: 1.125rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1rem;">Upcoming Interview</h3>
                <% if (locals.interviews && locals.interviews.length > 0) { %>
                    <% const nextInt = locals.interviews[0]; %>
                    <div style="background: var(--bg-tertiary); border-radius: var(--radius-lg); padding: 1rem; margin-bottom: 1rem;">
                        <h4 style="margin: 0 0 0.25rem 0; font-size: 0.95rem; font-weight: 600; color: var(--text-primary);"><%= nextInt.jobTitle %></h4>
                        <p style="margin: 0 0 0.5rem 0; font-size: 0.8125rem; color: var(--text-tertiary);"><%= nextInt.companyName %> &middot; with <%= nextInt.interviewerName %></p>
                        <p style="margin: 0; font-size: 0.875rem; font-weight: 600; color: var(--color-primary);">
                            📅 <%= new Date(nextInt.scheduledAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                        </p>
                    </div>
                    <a href="<%= nextInt.meetingLink %>" target="_blank" rel="noopener" class="btn btn-primary w-full btn-sm">Join Video Meeting</a>
                <% } else { %>
                    <p style="color: var(--text-tertiary); font-size: 0.875rem; margin: 0;">No upcoming interviews scheduled at the moment.</p>
                <% } %>
            </div>

            <div class="card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.5rem;">
                <h3 style="font-size: 1.125rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1rem;">Profile Strength</h3>
                <div style="margin-bottom: 0.75rem;">
                    <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.35rem;">
                        <span style="color: var(--text-secondary);">Completion</span>
                        <span style="font-weight: 600; color: var(--color-primary);">85%</span>
                    </div>
                    <div style="height: 6px; background: var(--bg-tertiary); border-radius: var(--radius-full); overflow: hidden;">
                        <div style="width: 85%; height: 100%; background: var(--color-primary);"></div>
                    </div>
                </div>
                <p style="font-size: 0.8125rem; color: var(--text-tertiary); margin-bottom: 1rem;">Add more skills and portfolio links to increase recruiter contact rates.</p>
                <a href="/account/profile" class="btn btn-outline-secondary w-full btn-sm">Update Profile</a>
            </div>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
