<%- include('../layout/header') %>

<div class="animate-fade-in" style="max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem;">
    <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 class="page-title" style="font-size: 1.875rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.25rem 0;">
                Saved Jobs
            </h1>
            <p class="page-subtitle" style="color: var(--text-tertiary); margin: 0;">Jobs you have bookmarked to review or apply for later</p>
        </div>
        <a href="/jobs" class="btn btn-outline-secondary">Browse More Jobs</a>
    </div>

    <% if (locals.savedJobs && locals.savedJobs.length > 0) { %>
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            <% locals.savedJobs.forEach(job => { %>
                <% const theme = locals.getCategoryTheme ? locals.getCategoryTheme(job.category) : { key: 'other', label: job.category || 'General', iconSvg: '' }; %>
                <div class="card job-card job-theme-<%= theme.key %>" data-job-theme="<%= theme.key %>" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                    <div style="display: flex; gap: 1rem; align-items: center;">
                        <div class="company-logo placeholder" style="width: 48px; height: 48px; border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; flex-shrink: 0;">
                            <%= job.companyName.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <h3 style="margin: 0; font-size: 1.15rem; font-weight: 600;">
                                <a href="/jobs/<%= job.id %>" style="color: var(--text-primary); text-decoration: none;"><%= job.title %></a>
                            </h3>
                            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.25rem;">
                                <span style="color: var(--text-tertiary); font-size: 0.875rem;"><%= job.companyName %> &middot; <%= job.location %> (<%= job.workMode %>)</span>
                                <span class="job-category-badge" style="font-size: 0.75rem;">
                                    <span class="job-category-dot"></span>
                                    <%- theme.iconSvg %>
                                    <span><%= theme.label %></span>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <% if (job.minSalary && job.maxSalary) { %>
                            <span style="font-weight: 600; color: var(--color-success); font-size: 0.9rem;">
                                $<%= Number(job.minSalary).toLocaleString() %> - $<%= Number(job.maxSalary).toLocaleString() %>
                            </span>
                        <% } %>
                        <a href="/jobs/<%= job.id %>" class="btn btn-primary btn-sm">View & Apply</a>
                        <button class="btn btn-ghost btn-sm text-danger" onclick="saveJob('<%= job.id %>'); setTimeout(() => window.location.reload(), 300);">Remove</button>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="empty-state" style="text-align: center; padding: 4rem 2rem; background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--text-tertiary); margin-bottom: 1rem;">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
            </svg>
            <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem;">No saved jobs</h3>
            <p style="color: var(--text-tertiary); margin-bottom: 1.5rem;">Click the bookmark icon on any job card to save it here for later.</p>
            <a href="/jobs" class="btn btn-primary">Find Jobs to Save</a>
        </div>
    <% } %>
</div>

<%- include('../layout/footer') %>
