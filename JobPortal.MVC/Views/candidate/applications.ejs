<%- include('../layout/header') %>

<div class="animate-fade-in" style="max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem;">
    <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 class="page-title" style="font-size: 1.875rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.25rem 0;">
                My Job Applications
            </h1>
            <p class="page-subtitle" style="color: var(--text-tertiary); margin: 0;">Track the progress of all applications you have submitted</p>
        </div>
        <a href="/jobs" class="btn btn-primary">Find More Jobs</a>
    </div>

    <% if (locals.applications && locals.applications.length > 0) { %>
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            <% locals.applications.forEach(app => { %>
                <div class="card" style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 1.75rem;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
                        <div>
                            <h2 style="font-size: 1.35rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.25rem 0;">
                                <a href="/jobs/<%= app.jobId %>" style="color: inherit; text-decoration: none;"><%= app.jobTitle %></a>
                            </h2>
                            <p style="color: var(--text-tertiary); font-size: 0.95rem; margin: 0;">
                                <strong><%= app.companyName %></strong> &middot; Submitted <%= new Date(app.appliedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                            </p>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <span class="badge <%= app.status === 'Interview Scheduled' ? 'badge-primary' : (app.status === 'Accepted' ? 'badge-success' : 'badge-soft') %>" style="font-size: 0.875rem; padding: 0.4rem 0.85rem;">
                                <%= app.status %>
                            </span>
                            <a href="/jobs/<%= app.jobId %>" class="btn btn-outline-secondary btn-sm">View Job</a>
                        </div>
                    </div>

                    <% if (app.coverLetter) { %>
                        <div style="background: var(--bg-tertiary); border-radius: var(--radius-lg); padding: 1rem; margin-bottom: 1.25rem; font-size: 0.875rem; color: var(--text-secondary); line-height: 1.6;">
                            <span style="font-weight: 600; display: block; margin-bottom: 0.25rem; color: var(--text-primary);">Cover Note:</span>
                            <%= app.coverLetter %>
                        </div>
                    <% } %>

                    <div style="border-top: 1px solid var(--border-primary); padding-top: 1rem;">
                        <h4 style="font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-tertiary); margin: 0 0 0.75rem 0;">Application Timeline</h4>
                        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
                            <% app.history.forEach((step, idx) => { %>
                                <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem;">
                                    <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--color-primary);"></div>
                                    <span style="font-weight: 600; color: var(--text-primary);"><%= step.status %></span>
                                    <span style="color: var(--text-tertiary);">(<%= new Date(step.date).toLocaleDateString() %>)</span>
                                    <% if (idx < app.history.length - 1) { %>
                                        <span style="color: var(--text-tertiary);">&rarr;</span>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="empty-state" style="text-align: center; padding: 4rem 2rem; background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--text-tertiary); margin-bottom: 1rem;">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem;">No applications yet</h3>
            <p style="color: var(--text-tertiary); margin-bottom: 1.5rem;">Browse open positions and apply with a single click.</p>
            <a href="/jobs" class="btn btn-primary">Browse Jobs</a>
        </div>
    <% } %>
</div>

<%- include('../layout/footer') %>
